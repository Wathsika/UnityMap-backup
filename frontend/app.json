{
  "expo": {
    "name": "UnityMap",
    "slug": "frontend",
    "scheme": "unitymap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "package": "com.anonymous.frontend"
    },
    "ios": {
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "UnityMap uses speech recognition to let you speak your destination hands-free.",
        "NSMicrophoneUsageDescription": "UnityMap needs microphone access to transcribe your spoken destination.",
        "NSLocationWhenInUseUsageDescription": "UnityMap uses your location to find accessibility barriers and plan accessible routes near you."
      },
      "bundleIdentifier": "com.anonymous.frontend"
    },
    "plugins": [
      "expo-speech-recognition",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "17ecf664-b78c-425b-aa2a-ba24660622b7"
      }
    }
  }
}
